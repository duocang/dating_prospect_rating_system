{
  "name": "vier",
  "private": true,
  "type": "module",
  "description": "VIER 择偶坐标：网页 + 服务端 + 可替换评分模块（零第三方依赖）",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server/server.mjs",
    "dev": "node --watch-path=server --watch-path=packages --watch-path=config server/server.mjs",
    "test": "node --test packages/scoring/test/scoring.test.mjs packages/matching/test/relations.test.mjs server/test/api.test.mjs server/test/security.test.mjs",
    "build:sim-pool": "node scripts/build-sim-pool.mjs",
    "purge:inactive": "node scripts/purge-inactive.mjs"
  }
}
