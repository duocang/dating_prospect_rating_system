.lead { font-size:25rpx; max-width:630rpx; }
.demo-banner { display:flex; align-items:center; gap:12rpx; margin:24rpx 0 18rpx; color:#786b58; font-size:21rpx; }
.dot { width:12rpx; height:12rpx; background:#b99163; border-radius:50%; }
.map-shell { padding:22rpx 20rpx 18rpx; background:#f1eee7; border:1rpx solid #e6e0d5; border-radius:24rpx; }
.map-heading { align-items:flex-end; }
.map-heading .section-title { display:block; margin:0; }
.map-subtitle { display:block; color:#85847c; font-size:20rpx; margin-top:4rpx; }
.city-label { color:#82745e; font-size:20rpx; }
.map { height:918rpx; position:relative; margin:22rpx 0 8rpx; }
.node { position:absolute; z-index:2; display:flex; align-items:center; gap:12rpx; width:46%; min-height:184rpx; padding:14rpx 12rpx; border-radius:18rpx; border:1rpx solid #e3ddd3; background:#fffefa; box-shadow:0 6rpx 18rpx rgba(58,50,38,.05); text-align:left; }
.node-a { left:0; top:0; }
.node-b { right:0; top:238rpx; }
.node-c { left:0; top:476rpx; border-color:#b9c8be; background:#fbfcf8; }
.node-d { right:0; top:714rpx; }
.node-copy { min-width:0; display:flex; flex-direction:column; align-items:flex-start; }
.node-role { color:#8b745b; font-size:18rpx; line-height:1.3; white-space:nowrap; }
.role-you { color:#36594b; }
.node-name { color:#282c29; font-size:22rpx; font-weight:600; line-height:1.45; white-space:nowrap; }
.node-meta { color:#777b74; font-size:18rpx; line-height:1.45; white-space:nowrap; }
.open-mark { position:absolute; right:12rpx; top:8rpx; color:#819087; font-size:23rpx; }
.portrait { position:relative; flex:none; width:88rpx; height:116rpx; overflow:hidden; border-radius:48rpx 48rpx 14rpx 14rpx; background:linear-gradient(155deg,#d9e0d6,#bdc8bb); }
.portrait-b { background:linear-gradient(155deg,#d8d1c5,#b9a992); }
.portrait-c { background:linear-gradient(155deg,#e6d6c5,#c4a995); }
.portrait-d { background:linear-gradient(155deg,#d8dfdc,#a9b5b1); }
.p-face { position:absolute; width:48rpx; height:57rpx; left:20rpx; top:18rpx; border-radius:48% 48% 46% 46%; background:#e9c3a3; z-index:2; }
.portrait-b .p-face,.portrait-d .p-face { background:#d5ad8c; }
.p-hair { position:absolute; width:53rpx; height:40rpx; left:18rpx; top:10rpx; border-radius:50% 52% 18% 18%; background:#403b35; z-index:3; }
.portrait-b .p-hair { background:#353b39; width:48rpx; height:30rpx; left:20rpx; }
.portrait-c .p-hair { background:#554137; }
.portrait-d .p-hair { background:#373b39; width:49rpx; height:31rpx; left:19rpx; }
.eyes { position:absolute; top:25rpx; left:10rpx; width:28rpx; height:5rpx; border-top:2rpx solid #51433c; }
.smile { position:absolute; left:18rpx; top:41rpx; width:14rpx; height:7rpx; border-bottom:2rpx solid #9c6555; border-radius:50%; }
.p-body { position:absolute; z-index:1; width:90rpx; height:49rpx; left:-1rpx; bottom:-8rpx; border-radius:50% 50% 0 0; background:#66776c; }
.portrait-a .p-body { background:#8b7063; }
.portrait-c .p-body { background:#667b75; }
.portrait-d .p-body { background:#5e6965; }
.edge { position:absolute; z-index:1; height:2rpx; border-radius:9rpx; background:#9ba99d; transform-origin:left center; opacity:.9; }
.edge::after { content:""; position:absolute; right:-7rpx; top:-6rpx; width:11rpx; height:11rpx; border:2rpx solid #74877a; border-left-color:transparent; border-bottom-color:transparent; border-radius:50%; transform:rotate(45deg); }
.edge-ab { left:41%; top:91rpx; width:37%; transform:rotate(65deg); }
.edge-bc { left:59%; top:328rpx; width:37%; transform:rotate(115deg); height:2rpx; }
.edge-cd { left:41%; top:567rpx; width:37%; transform:rotate(65deg); height:3rpx; background:#74877a; }
.legend { display:flex; justify-content:space-between; align-items:center; color:#7b8079; font-size:19rpx; margin-top:2rpx; }
.legend view { display:flex; align-items:center; gap:9rpx; }
.legend-line { width:28rpx; height:2rpx; background:#89998e; display:inline-block; }
.legend-note { color:#99958c; letter-spacing:1rpx; }
.compare-grid { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; margin-top:20rpx; }
.compare-card { min-height:164rpx; padding:18rpx; border-radius:18rpx; border:1rpx solid #e4ddd1; background:#fffefa; text-align:left; }
.compare-kicker { display:block; color:#8a745b; font-size:19rpx; }
.compare-title { display:block; margin-top:8rpx; color:#303a34; font-size:25rpx; font-weight:600; }
.compare-arrow { display:block; margin-top:12rpx; color:#66796d; font-size:19rpx; }
.profile-cta { margin-top:20rpx; }
.disclaimer { display:block; margin:20rpx 4rpx 0; }
