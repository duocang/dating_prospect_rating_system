page {
  background: #f7f4ee;
  color: #282c29;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
}

view, text, button, input, textarea { box-sizing: border-box; }
button { margin: 0; padding: 0; border: 0; background: transparent; line-height: inherit; }
button::after { border: 0; }

.page { min-height: 100vh; padding: 28rpx 30rpx 54rpx; }
.topbar { display:flex; align-items:center; gap:12rpx; margin-bottom:28rpx; }
.brand-mark { width:42rpx; height:42rpx; border:1rpx solid #344a42; border-radius:50%; color:#344a42; display:flex; align-items:center; justify-content:center; font-family:Georgia,serif; font-size:25rpx; }
.brand { font-family:Georgia,"Times New Roman",serif; font-size:25rpx; letter-spacing:4rpx; font-weight:600; }
.edition { margin-left:auto; color:#8a8b83; font-size:21rpx; letter-spacing:1rpx; }
.eyebrow { color:#8b745b; font-size:21rpx; letter-spacing:2rpx; text-transform:uppercase; }
.page-title { margin:10rpx 0 8rpx; font-family:"Songti SC",serif; font-size:42rpx; font-weight:500; line-height:1.25; letter-spacing:1rpx; }
.muted { color:#777b74; }
.tiny-note { color:#8b8c84; font-size:20rpx; line-height:1.55; }
.section-title { margin:34rpx 0 16rpx; font-size:27rpx; font-weight:600; }
.panel { background:#fffefa; border:1rpx solid #e5e0d7; border-radius:22rpx; padding:24rpx; box-shadow:0 8rpx 26rpx rgba(55,49,39,.035); }
.pill { display:inline-flex; align-items:center; min-height:36rpx; padding:3rpx 12rpx; border-radius:100rpx; background:#e9eee9; color:#395348; font-size:20rpx; }
.pill-sand { background:#f0e7dc; color:#80654d; }
.primary-button { min-height:88rpx; padding:0 28rpx; border-radius:16rpx; background:#344a42; color:#fffdf8; font-size:27rpx; font-weight:600; display:flex; align-items:center; justify-content:center; }
.secondary-button { min-height:78rpx; padding:0 24rpx; border:1rpx solid #cfc8bc; border-radius:15rpx; color:#3e4741; background:#fffefa; font-size:24rpx; display:flex; align-items:center; justify-content:center; }
.back-link { color:#52635b; font-size:24rpx; padding:12rpx 0; }
.row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.divider { height:1rpx; background:#ebe7df; margin:20rpx 0; }
